# CNU 학사 길잡이 공통 설정 (infra/*.sh 에서 source 한다)
REGION="${REGION:-ap-northeast-2}"
ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"

PROJECT_TAG="CNU-Academic-Guide"
WEEK_TAG="Week2"

DOCS_BUCKET="cnu-guide-docs-${ACCOUNT_ID}"
CHAT_TABLE="CnuGuide-ChatLogs"
LAMBDA_ROLE="CnuGuide-ChatApiRole"
LAMBDA_NAME="cnu-guide-chat-api"
API_NAME="cnu-guide-api"
LOG_RETENTION_DAYS=14
