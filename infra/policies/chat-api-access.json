{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDocsBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__DOCS_BUCKET__"
    },
    {
      "Sid": "ReadDocs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__DOCS_BUCKET__/*"
    },
    {
      "Sid": "WriteChatLogs",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/__CHAT_TABLE__"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/aws/lambda/__LAMBDA_NAME__:*"
    }
  ]
}
